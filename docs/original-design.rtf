\cf0 \strokec2 \
To monitor 
\f3\b MySQL with Galera
\f0\b0  (Codership's Galera Cluster for MySQL) in LogicMonitor, use a 
\f3\b Groovy-based Script DataSource
\f0\b0  to poll 
\f1\fs28 wsrep_%
\f0\fs32  variables and map string states (like 
\f1\fs28 Primary
\f0\fs32  and 
\f1\fs28 Synced
\f0\fs32 ) into numeric codes that LogicMonitor can graph and alert on.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf0 \strokec2 \
\pard\pardeftab720\partightenfactor0

\f3\b\fs40 \cf0 \strokec2 1. Groovy Collection Script\
\pard\pardeftab720\partightenfactor0

\f0\b0\fs32 \cf0 In LogicMonitor, go to 
\f3\b Settings > LogicModules > DataSources > Add
\f0\b0 , set 
\f3\b Collector
\f0\b0  to 
\f3\b Script
\f0\b0  (Embedded Groovy), and paste the following script. It uses LogicMonitor\'92s standard 
\f1\fs28 jdbc.mysql.user
\f0\fs32  and 
\f1\fs28 jdbc.mysql.pass
\f0\fs32  device properties.\
\pard\pardeftab720\partightenfactor0

\fs28 \cf0 \strokec2 \
\pard\pardeftab720\partightenfactor0

\fs40 \cf0 groovy\
\pard\pardeftab720\partightenfactor0

\f1\fs28 \cf0 \strokec2 import groovy.sql.Sql\
\
def host = hostProps.get("system.hostname")\
def user = hostProps.get("jdbc.mysql.user")\
def pass = hostProps.get("jdbc.mysql.pass")\
def port = hostProps.get("jdbc.mysql.port") ?: "3306"\
\
def url = "jdbc:mysql://$\{host\}:$\{port\}/?useSSL=false&allowPublicKeyRetrieval=true"\
def driver = "com.mysql.cj.jdbc.Driver"\
\
def wsrep = [:]\
\
try \{\
    Sql.withInstance(url, user, pass, driver) \{ sql ->\
        sql.eachRow("SHOW GLOBAL STATUS LIKE 'wsrep_%'") \{ row ->\
            wsrep[row.Variable_name] = row.Value\
        \}\
    \}\
\
    // 1. Cluster Status: Primary = 1, Non-Primary / Disconnected = 0\
    def clusterStatus = (wsrep['wsrep_cluster_status'] == 'Primary') ? 1 : 0\
    println "cluster_status=$\{clusterStatus\}"\
\
    // 2. Node State: 4=Synced, 3=Donor/Desynced, 2=Joined, 1=Joining, 0=Other/Error\
    def stateMap = [\
        'Synced'        : 4,\
        'Donor/Desynced': 3,\
        'Joined'        : 2,\
        'Joining'       : 1\
    ]\
    def localState = stateMap.get(wsrep['wsrep_local_state_comment'], 0)\
    println "local_state=$\{localState\}"\
\
    // 3. Ready Status: ON = 1, OFF = 0\
    def ready = (wsrep['wsrep_ready'] == 'ON') ? 1 : 0\
    println "ready=$\{ready\}"\
\
    // 4. Connected Status: ON = 1, OFF = 0\
    def connected = (wsrep['wsrep_connected'] == 'ON') ? 1 : 0\
    println "connected=$\{connected\}"\
\
    // 5. Numeric Metrics\
    println "cluster_size=$\{wsrep['wsrep_cluster_size'] ?: 0\}"\
    println "flow_control_paused=$\{wsrep['wsrep_flow_control_paused'] ?: 0\}"\
    println "recv_queue_avg=$\{wsrep['wsrep_local_recv_queue_avg'] ?: 0\}"\
    println "send_queue_avg=$\{wsrep['wsrep_local_send_queue_avg'] ?: 0\}"\
    println "cert_failures=$\{wsrep['wsrep_local_cert_failures'] ?: 0\}"\
    println "bf_aborts=$\{wsrep['wsrep_local_bf_aborts'] ?: 0\}"\
\
    return 0\
\} catch (Exception e) \{\
    println "Error: $\{e.message\}"\
    return 1\
\}
\f0\fs24 \
\pard\pardeftab720\qc\partightenfactor0

